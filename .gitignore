node_modules/

# The test suite lives at the repo root but its code expects a tests/ subfolder,
# so running it copies run-all.js + quote-card.test.js into tests/ and deletes
# the folder afterwards (see CLAUDE.md section 3, gate B). On Windows the
# node_modules link inside it is a real copy, so the cleanup sometimes fails and
# leaves the folder behind. Ignoring it means a half-deleted tests/ can never be
# committed by accident.
tests/

# Playwright failure screenshots and traces. Written by npm run test:browser,
# never useful in the repo, and currently large enough to notice.
test-results/
playwright-report/

# Written by "npx playwright test > results.txt" when capturing output to paste
# into a chat. Pure scratch — never belongs in the repo.
results.txt

# Playwright's record of the last run. Regenerated every time, and it showed up
# as a change on every single test run until it was ignored.
.last-run.json
