rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ---- Public-facing collections -------------------------------------
    /* A quote request has to be creatable by a stranger — that is the whole
       point of the public form — but `allow create: if true` let anyone write
       ANY fields, including quotedPrice and approvalStatus. Somebody could
       have posted a quote that already claimed a price, or already claimed to
       be approved, and it would have landed in the office queue looking real.
       Both public creates (the quote form, and the address-change quote in the
       portal) set status:'new' and never touch pricing, so requiring that and
       refusing the staff-only fields costs the customer nothing.

       ⚠ Written as a DENY LIST, not an allow list, deliberately. An allow list
       has to name every field the public form sends, and the moment somebody
       adds one — `buildings` arrived with the multi-address work — the form
       starts failing for real customers with no test to catch it, because
       rules are covered by neither CI nor Netlify. A deny list closes the
       actual hole (asserting a price or an approval) and cannot break a form
       that grows.

       NOT changed: update/read/delete were already staff-only. CLAUDE.md §8
       describes the quotes collection as open to unauthenticated updates for
       the approve flow — that is out of date; the flow moved server-side into
       quoteRespond and the rule was tightened. */
    match /quotes/{id} {
      allow create: if request.resource.data.status == 'new'
                    && !('quotedPrice' in request.resource.data)
                    && !('approvalStatus' in request.resource.data)
                    && !('convertedToCustomerAt' in request.resource.data)
                    && !('quoteArchived' in request.resource.data);
      allow read, update, delete: if request.auth != null;
    }
    /* Same shape of problem, smaller blast radius: a message cannot claim to
       have already been read or replied to, and cannot be enormous. The portal
       writes these with several different shapes (light changes, cancellations,
       RSVP notes), so again a deny list rather than an allow list. */
    match /messages/{id} {
      allow create: if !('read' in request.resource.data && request.resource.data.read == true)
                    && !('responded' in request.resource.data && request.resource.data.responded == true)
                    && (!('message' in request.resource.data) || request.resource.data.message.size() < 5000);
      allow read, update, delete: if request.auth != null;
    }
    match /reviews/{id}                { allow read: if true; allow write: if request.auth != null; }
    match /gallery/{id}                { allow read: if true; allow write: if request.auth != null; }
    match /heroImages/{id}             { allow read: if true; allow write: if request.auth != null; }
    match /faq/{id}                    { allow read: if true; allow write: if request.auth != null; }
    match /siteContent/{id}            { allow read: if true; allow write: if request.auth != null; }
    // ---- invoices -------------------------------------------------------
    // PHASE 3 (locked down). Invoices were the last publicly readable
    // customer data — names, addresses, and balances, with phone numbers as
    // doc IDs. The Make a Payment page now reads them only through the
    // portalInvoice Cloud Function, which verifies the customer's portal
    // token or typed last name server-side. Staff portals are authenticated
    // and read invoices directly.
    match /invoices/{id}               { allow read: if request.auth != null; allow write: if request.auth != null; }
    // ---- jobAddresses ---------------------------------------------------
    // PHASE 2 (locked down). Customer records are no longer publicly readable.
    // The Member Portal reaches this collection only through Cloud Functions
    // (portalLookup / portalSave / portalRsvp / quoteRespond), which run with
    // Admin privileges and bypass these rules. Staff portals (admin.html and
    // employee.html) are authenticated and read it directly.
    match /jobAddresses/{id}           { allow read, write: if request.auth != null; }
    // ---- Staff-only collections ----------------------------------------
    match /scheduledRoutes/{id}        { allow read, write: if request.auth != null; }
    // The Schedule tab's own route plan. Without this rule every save was
    // denied and the plan could never load back — the tab asked to import
    // the CSV again every time it was opened.
    match /routeSchedule/{id}          { allow read, write: if request.auth != null; }
    match /messageFolders/{id}         { allow read, write: if request.auth != null; }
    match /timeLogs/{id}               { allow read, write: if request.auth != null; }
    match /employeeNames/{id}          { allow read, write: if request.auth != null; }
    match /crews/{id}                  { allow read, write: if request.auth != null; }
    match /crewOverrides/{id}          { allow read, write: if request.auth != null; }
    match /dailyChecklists/{id}        { allow read, write: if request.auth != null; }
    match /employeeMessages/{id}       { allow read, write: if request.auth != null; }
    match /teamMessages/{id}           { allow read, write: if request.auth != null; }
    match /timecardChangeRequests/{id} { allow read, write: if request.auth != null; }
    match /pricing/{id}                { allow read, write: if request.auth != null; }
    match /settings/{id}               { allow read, write: if request.auth != null; }
    match /emailTemplateFolders/{id}   { allow read, write: if request.auth != null; }
    match /emailTemplates/{id}         { allow read, write: if request.auth != null; }
    match /smsTemplateFolders/{id}     { allow read, write: if request.auth != null; }
    match /smsTemplates/{id}           { allow read, write: if request.auth != null; }
    match /availableCustomerNumbers/{id} { allow read, write: if request.auth != null; }
    // ⭐ WHERE A REMOVED CUSTOMER GOES. Owner, 2026-08-20: "the customer record
    // should only exist in archive and recycle after i click delete customer."
    // Staff only, and never public: it holds the whole record of somebody who was a
    // customer, phone and address and all, which is exactly what jobAddresses holds
    // and is protected the same way.
    match /archivedCustomers/{id}      { allow read, write: if request.auth != null; }
    // ---- Staff-only: employee tools ------------------------------------
    match /employeeNotes/{id}          { allow read, write: if request.auth != null; }
    match /employeeRequests/{id}       { allow read, write: if request.auth != null; }
    match /employeeCategories/{id}     { allow read, write: if request.auth != null; }
    match /houseMaps/{id}              { allow read, write: if request.auth != null; }
    match /roleTemplates/{id}          { allow read, write: if request.auth != null; }
    // ---- Staff-only: warehouse -----------------------------------------
    match /warehouseExtras/{id}        { allow read, write: if request.auth != null; }
    match /warehouseGoals/{id}         { allow read, write: if request.auth != null; }
    match /inventoryItems/{id}         { allow read, write: if request.auth != null; }
    // ---- Staff-only: finance -------------------------------------------
    match /expenses/{id}               { allow read, write: if request.auth != null; }
    match /bills/{id}                  { allow read, write: if request.auth != null; }
    match /budgetCategories/{id}       { allow read, write: if request.auth != null; }
    match /savingsGoals/{id}           { allow read, write: if request.auth != null; }
    match /debtAccounts/{id}           { allow read, write: if request.auth != null; }
    match /creditCards/{id}            { allow read, write: if request.auth != null; }
    match /ccTransactions/{id}         { allow read, write: if request.auth != null; }
    match /ccPayments/{id}             { allow read, write: if request.auth != null; }
    match /ccRecurringOverrides/{id}   { allow read, write: if request.auth != null; }
    match /paymentImports/{id}         { allow read, write: if request.auth != null; }
    match /paymentImportFolders/{id}   { allow read, write: if request.auth != null; }
    match /yearlySnapshots/{id}        { allow read, write: if request.auth != null; }
    // ---- Staff-only: misc ----------------------------------------------
    match /customCodes/{id}            { allow read, write: if request.auth != null; }
    match /savedEmailTemplates/{id}    { allow read, write: if request.auth != null; }
    // ---- Staff-only: internal QA / Test Checklist tab -------------------
    match /projectPeople/{id}          { allow read, write: if request.auth != null; }
    match /projectTests/{id}           { allow read, write: if request.auth != null; }
    // ---- Health-check decisions -----------------------------------------
    // Addie, 2026-08-21: "I want to be able to approve or deny it", and the deny
    // is PER MEMBER — "I should be able to choose what member I'm denying for and
    // approve for all other members". So the decision cannot live on the finding
    // or on a System notice: `messages` refuses any create over 5,000 characters,
    // and a check with fifty rows could never carry fifty answers. One document
    // per check+finding, keyed on a fingerprint of the values, so an exception
    // lapses by itself when that member's data moves.
    // Staff only. Nothing public ever reads or writes these.
    match /healthCheckDecisions/{id}   { allow read, write: if request.auth != null; }
    // ---- Per-login preferences -----------------------------------------
    // Favourites, pinned nav items, collapsed sections and sub-tab order.
    // The document id IS the signed-in user's uid (see savePrefs /
    // loadUserPrefs in admin.html), so each person can only touch their own.
    // Without this block every preference write was silently denied.
    match /adminUserPrefs/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // ---- Nightly invoice automation ------------------------------------
    // Written only by the sendNightlyInvoices Cloud Function, which uses the
    // Admin SDK and bypasses these rules — so the browser never needs write
    // access. Staff read it to see the "Last 10 nightly runs" log.
    match /nightlyInvoiceLog/{id}      { allow read: if request.auth != null; allow write: if false; }
    // ---- Weather watch --------------------------------------------------
    // Yesterday's forecast for each upcoming route day, kept so the evening
    // run can tell what CHANGED. Written only by the weatherWatch Cloud
    // Function, which uses the Admin SDK and bypasses these rules.
    match /weatherWatch/{id}           { allow read: if request.auth != null; allow write: if false; }
    // ---- Activity log ----------------------------------------------------
    // Who changed what, one plain-English sentence per entry. Append-only by
    // convention and NEVER read back into business logic — it is a record for
    // people to read, which is what makes it safe to write from a dozen
    // handlers without any of them becoming riskier.
    match /activity/{id}               { allow read, write: if request.auth != null; }
    // ---- Payment ledger --------------------------------------------------
    // One row per payment: amount, method, when, who entered it, and a
    // reference (a PayPal capture id, or the tag of the file it was imported
    // from). Written by the office AND by the Cloud Function on a card payment
    // (the Admin SDK bypasses these rules, so no public write is needed).
    // Append-only by convention — nothing reads it back into a balance, so a
    // wrong row here can embarrass but can never mis-bill anybody.
    match /payments/{id}               { allow read, write: if request.auth != null; }
    // ---- Unmatched payments ---------------------------------------------
    // A PayPal capture that succeeded but had no invoice to apply it to (the
    // invoice doc moves when a customer changes their phone or email). Written
    // only by recordUnmatchedPayment in the Cloud Function, which uses the
    // Admin SDK and bypasses these rules. Staff read it to chase the money.
    match /unmatchedPayments/{id}      { allow read: if request.auth != null; allow write: if false; }
    // portalRateLimits is written only by Cloud Functions, which bypass rules.
    // No match block is needed — anything unlisted is denied by default.
  }
}
