# Netlify custom headers.
#
# The three HTML files are the app itself — when a new version deploys, every
# browser must pick it up on the next load, not days later. Without this,
# browsers were holding old copies of index.html/admin.html after deploys,
# which made fresh fixes look broken (the file was right on Netlify, stale in
# the browser). no-cache does NOT mean "never store": it means "check with the
# server before using your copy", which costs one cheap request and always
# yields the current build.
#
# Images, fonts and other assets keep normal caching — they change rarely and
# are heavy, so re-downloading them every visit would slow the site for no
# benefit.
#
# /js/* is part of the app too, for exactly the same reason. As code moves out
# of the big HTML files into modules under /js, a cached copy of one of those
# would be a stale half of the app running against a fresh half — the same
# "fixed on Netlify, broken in the browser" problem, but harder to spot because
# the page itself would look up to date.

/index.html
  Cache-Control: no-cache

# The short quote link (/q/<token>) is a Netlify rewrite to index.html — the
# app itself, served under a path that matches neither /index.html nor / above.
# Without this it is the one address the app is reachable at that a browser is
# free to cache, and a customer following a quote link would be the one person
# running a stale copy.
/q/*
  Cache-Control: no-cache

# And /r/<token>, the referral link, for exactly the same reason — it is the same
# index.html answering a live link somebody was sent.
/r/*
  Cache-Control: no-cache

/js/*
  Cache-Control: no-cache

/admin.html
  Cache-Control: no-cache

/employee.html
  Cache-Control: no-cache

# The connections map and the summary the admin badge reads. Both are GENERATED
# and change with the code they describe, so a cached copy is a map that quietly
# disagrees with the app — and a stale map is worse than no map, because it reads
# as current. Same no-cache reasoning as the three pages above.
/connections.html
  Cache-Control: no-cache

/connections.json
  Cache-Control: no-cache

/
  Cache-Control: no-cache
